# Generated by install.sh on first install. Values below are defaults/placeholders.
# File permissions must stay 600: it contains secrets.

AIOPS_VERSION=0.2.5-dev.2
# Images are pulled from <prefix>-backend and <prefix>-web.
AIOPS_IMAGE_PREFIX=ghcr.io/mbechc/aiops
COMPOSE_PROJECT_NAME=aiops
AIOPS_HOSTNAME=aiops.local
HTTPS_PORT=443
HTTP_PORT=80
TZ=UTC

POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change-me

# JWT signing secret and Fernet key (credential encryption at rest).
SECRET_KEY=change-me
FERNET_KEY=change-me

# Local LLM (CPU). Only used once an admin selects Settings > AI assistance > Local LLM: the host
# updater then starts the ollama container and pulls this model. Nothing is downloaded before that.
# Any Ollama model tag works.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_PARALLEL=1
OLLAMA_MEM_LIMIT=10g
LLM_TIMEOUT_SECONDS=240

# Worker concurrency (Catalyst Center calls are rate limited per source anyway).
WORKER_CONCURRENCY=4

# Comma list. "mock" also starts the simulated Catalyst Center 2.3/3.1 services for testing.
# "llm" is added and removed by the host updater when Local LLM is enabled or disabled in Settings.
COMPOSE_PROFILES=

# Updates (Settings > Updates). Track: production (stable releases) or development (also pre-releases).
AIOPS_UPDATE_REPO=mbechc/AI-Assisted-Ops
AIOPS_UPDATE_CHANNEL=production
# Minutes between the host's GitHub reachability checks (Dashboard: Connected / AirGapped).
AIOPS_CONNECTIVITY_INTERVAL_MIN=15
